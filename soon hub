local function getClosestAny(range)
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, best = nil, range or 160

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < best then best = d closest = {Root = root, Model = plr.Character} end
            end
        end
    end

    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then
        for _, npc in pairs(enemies:GetChildren()) do
            if npc:IsA("Model") then
                local hum = npc:FindFirstChildOfClass("Humanoid")
                local root = npc:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    local d = (root.Position - myRoot.Position).Magnitude
                    if d < best then best = d closest = {Root = root, Model = npc} end
                end
            end
        end
    end
    return closest
end

task.spawn(function()
    while true do
        if FastAttack then
            local char = lp.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                local Modules = ReplicatedStorage:FindFirstChild("Modules")
                local Net = Modules and Modules:FindFirstChild("Net")
                local RegisterAttack = Net and Net:FindFirstChild("RE/RegisterAttack")
                local RegisterHit = Net and Net:FindFirstChild("RE/RegisterHit")
                local targetData = getClosestAny(160)
                if RegisterAttack and RegisterHit and targetData then
                    local model = targetData.Model
                    local root = targetData.Root
                    local head = model:FindFirstChild("Head") or root
                    pcall(function()
                        RegisterAttack:FireServer(0.01)
                        local hits = {}
                        for _, part in pairs(model:GetDescendants()) do
                            if part:IsA("BasePart") then
                                table.insert(hits, {model, part})
                            end
                        end
                        if #hits == 0 then table.insert(hits, {model, root}) end
                        RegisterHit:FireServer(head, hits)
                    end)
                end
            end
            task.wait(0.02)
        else
            task.wait(0.1)
        end
    end
end)

