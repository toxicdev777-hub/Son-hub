-- ==================== ESP CURSED (all players, even behind you) ====================
local function clearESP()
    for _, d in pairs(ESP.drawings) do
        pcall(function() d:Remove() end)
    end
    ESP.drawings = {}
end

local function worldToScreen(worldPos)
    local pos, _ = camera:WorldToViewportPoint(worldPos)
    -- keep line working when target is behind camera
    if pos.Z < 0 then
        local inv = camera.CFrame:PointToObjectSpace(worldPos)
        local rel = Vector3.new(-inv.X, inv.Y, inv.Z)
        local fov = math.rad(camera.FieldOfView)
        local aspect = camera.ViewportSize.X / camera.ViewportSize.Y
        local sy = math.tan(fov * 0.5)
        local sx = sy * aspect
        local ndcX = rel.X / (rel.Z * sx)
        local ndcY = rel.Y / (rel.Z * sy)
        local vx = (0.5 + 0.5 * ndcX) * camera.ViewportSize.X
        local vy = (0.5 - 0.5 * ndcY) * camera.ViewportSize.Y
        return Vector2.new(vx, vy), false
    end
    return Vector2.new(pos.X, pos.Y), pos.Z > 0
end

local function updateESP()
    clearESP()
    if not ESP.Enabled then return end

    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myScreen = worldToScreen(myRoot.Position)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= lp and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character.HumanoidRootPart
            if hum and hum.Health > 0 then
                local screenPos, inFront = worldToScreen(root.Position)
                local pos, onScreen = camera:WorldToViewportPoint(root.Position)

                if onScreen then
                    if ESP.Box then
                        local size = Vector2.new(
                            math.clamp(1800 / math.max((camera.CFrame.Position - root.Position).Magnitude, 1), 8, 120),
                            math.clamp(3600 / math.max((camera.CFrame.Position - root.Position).Magnitude, 1), 16, 240)
                        )
                        local function boxLine(a, b)
                            local l = Drawing.new("Line")
                            l.From = a
                            l.To = b
                            l.Color = Color3.fromRGB(255, 50, 50)
                            l.Thickness = 1.4
                            l.Visible = true
                            table.insert(ESP.drawings, l)
                        end
                        local tl = Vector2.new(pos.X - size.X/2, pos.Y - size.Y/2)
                        local tr = Vector2.new(pos.X + size.X/2, pos.Y - size.Y/2)
                        local bl = Vector2.new(pos.X - size.X/2, pos.Y + size.Y/2)
                        local br = Vector2.new(pos.X + size.X/2, pos.Y + size.Y/2)
                        boxLine(tl, tr) boxLine(tr, br) boxLine(br, bl) boxLine(bl, tl)
                    end

                    if ESP.Health then
                        local hp = math.floor((hum.Health / hum.MaxHealth) * 100)
                        local color = Color3.fromRGB(0, 255, 0)
                        if hp <= 50 then color = Color3.fromRGB(255, 255, 0) end
                        if hp <= 20 then color = Color3.fromRGB(255, 0, 0) end
                        local t = Drawing.new("Text")
                        t.Text = hp .. "%"
                        t.Size = 13
                        t.Center = true
                        t.Outline = true
                        t.Color = color
                        t.Position = Vector2.new(pos.X, pos.Y + 28)
                        t.Visible = true
                        table.insert(ESP.drawings, t)
                    end

                    if ESP.Name then
                        local t = Drawing.new("Text")
                        t.Text = string.format("%s\n@%s", plr.DisplayName or plr.Name, plr.Name)
                        t.Size = 13
                        t.Center = true
                        t.Outline = true
                        t.Color = Color3.fromRGB(255, 255, 255)
                        t.Position = Vector2.new(pos.X, pos.Y - 42)
                        t.Visible = true
                        table.insert(ESP.drawings, t)
                    end
                end

                -- Cursed line to EVERY player (looking or not)
                if ESP.Line and myScreen and screenPos then
                    local l = Drawing.new("Line")
                    l.From = myScreen
                    l.To = screenPos
                    l.Color = Color3.fromRGB(120, 0, 0)
                    l.Thickness = 1.7
                    l.Visible = true
                    table.insert(ESP.drawings, l)
                end
            end
        end
    end
end

